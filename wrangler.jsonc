{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatwerk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "OVERLAY", "class_name": "OverlayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OverlayObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatwerk",
      "database_id": "00000000-0000-0000-0000-000000000000", // Set this when the D1 database is created.
      "migrations_dir": "migrations"
    }
  ],
  "dev": {
    "port": 17173
  }
}
