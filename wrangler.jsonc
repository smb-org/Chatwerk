{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatwerk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chatwerk.esembe.app", "custom_domain": true }],
  "vars": {
    "TWITCH_CLIENT_ID": "fl0p8o3ci86ubuv14ljn21qa7z5sry"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": ["/api/*", "/auth/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "OVERLAY", "class_name": "OverlayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OverlayObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatwerk",
      "database_id": "88decf9e-5bf3-4683-94e7-2b2a12126b4e",
      "migrations_dir": "migrations"
    }
  ],
  "dev": {
    "port": 17173
  }
}
